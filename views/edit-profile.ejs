<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Attractive Profile Page</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background: linear-gradient(120deg, #f0f7ff, #c8dfff);
            color: #fff;
        }
        .menu-bar {
            background: linear-gradient(120deg, #f0f7ff, #c8dfff);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        }
        .menu-bar ul {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
        }
        .menu-bar ul li {
            margin: 0 15px;
        }
        .menu-bar ul li a {
            text-decoration: none;
            color: #fff;
            font-size: 16px;
            font-weight: bold;
            transition: color 0.3s;
        }
        .menu-bar ul li a:hover {
            color: #3D52A0;
        }
        .profile-container {
            max-width: 700px;
            margin: 50px auto;
            background: #fff;
            color: #333;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
        }
        .profile-header {
            text-align: center;
            margin-bottom: 20px;
        }
        .profile-header h2 {
            margin: 0;
            font-size: 28px;
            color: #333;
        }
        .profile-photo {
            text-align: center;
            margin-bottom: 20px;
        }
        .profile-photo img {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #3D52A0;
            transition: transform 0.3s ease;
        }
        .profile-photo img:hover {
            transform: scale(1.1);
        }
        .profile-field {
            margin-bottom: 15px;
            padding: 10px 0;
            border-bottom: 1px solid #ddd;
        }
        .profile-field label {
            font-weight: bold;
            display: block;
            margin-bottom: 5px;
            color: #3D52A0;
        }
        .profile-field span {
            display: block;
            font-size: 16px;
        }
        .button-container {
            text-align: center;
        }
        button {
            padding: 12px 25px;
            font-size: 16px;
            background: #3D52A0;
            color: #fff;
            border: none;
            border-radius: 25px;
            cursor: pointer;
            transition: background 0.3s ease;
        }
        button:hover {
            background: #30417e
        }

        #editButton a, #logoutButton a{
            text-decoration: none;
            color: white;
        }
        header {
            background:#3D52A0;
            color: #fff;
            padding: 1rem 2rem;
            text-align: center;
        }

        header h1 {
            margin: 0;
            font-size: 2.5rem;
        }

        header nav {
            margin-top: 0.5rem;
        }

        header nav a {
            color: #fff;
            text-decoration: none;
            margin: 0 1rem;
            font-weight: bold;
        }

        header nav a:hover {
            font-size: larger;
        }
    </style>
</head>
<body>
    <header>
        <h1 style="color: white;">Welcome, <%= user.name %>!</h1>
        <nav>
            <a href="/complaints/raise-complaint/<%= user._id %>">Raise Complaints</a>
            <a href="/complaints/my-complaints/<%= user._id %>">My Reports</a>
            <a href="/profile/<%= user._id %>">Profile</a>
            <a href="/complaints/public-complaints/<%= user._id %>">View all Reports</a>
            <a href="/home#about">About</a>
            <a href="/home#features">Features</a>
            <a href="/home#contact">Contact</a>
            <a href="/logout">Logout</a>
        </nav>
    </header>
    <div class="menu-bar">
    </div>

    <div class="profile-container">
        <form id="profileForm" action="/edit-profile/<%= user._id %>" method="POST" enctype="multipart/form-data">
            <div class="profile-header">
                <div class="profile-photo">
                    <img src="/uploads/<%= user.photo %>" alt="Profile Photo" id="photo">
                    <input type="file" name="photo" accept="image/*">
                </div>
                <h1><%= user.name %>!</h1>
            </div>
            <div class="profile-field">
                <label for="name">Name:</label>
                <input type="text" id="name" value="<%= user.name %>" name="name" required>
            </div>
            <div class="profile-field">
                <label for="dob">Date of Birth:</label>
                <input type="date" id="dob" name="dob" value="<%= user.dob %>" required min="1930-01-01" max="2010-01-01">
            </div>
            <div class="profile-field">
                <label for="gender">Gender:</label>
                <select id="gender" name="gender">
                    <option value="Male" selected hidden disabled>--Select Gender</option>
                    <option value="Male" <%= user.gender === 'Male' ? 'selected' : '' %>>Male</option>
                    <option value="Female" <%= user.gender === 'Female' ? 'selected' : '' %>>Female</option>
                    <option value="Other" <%= user.gender === 'Other' ? 'selected' : '' %>>Other</option>
                </select>
            </div>
            <div class="profile-field">
                <label for="address">Address:</label>
                <input type="text" id="address" name="address" required value="<%= user.address %>">
            </div>
            <div class="profile-field">
                <label for="email">Email:</label>
                <input type="email" id="email" name="email" value="<%= user.email %>">
            </div>
            <div class="profile-field">
                <label for="phone">Phone Number:</label>
                <input type="tel" id="phone" name="phone" required value="<%= user.phone %>">
            </div>
            <div class="profile-field">
                <label for="about">About:</label>
                <textarea id="about" name="about"><%= user.about %></textarea>
            </div>
            <div class="button-container">
                <button type="button" id="logoutButton"><a href="/logout">Logout</a></button>
                <button type="submit" id="saveButton">Save</button>
            </div>
        </form>
    </div>
</body>
</html>